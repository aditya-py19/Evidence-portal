DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/evidence_portal"
JWT_SECRET="replace-with-a-long-random-secret"

# Server-only Sightengine credentials. Never prefix these with VITE_ and never commit .env.
SIGHTENGINE_API_USER="your-sightengine-api-user"
SIGHTENGINE_API_SECRET="your-revoked-and-regenerated-sightengine-api-secret"

# Pinata IPFS Storage Credentials
PINATA_API_KEY="your_pinata_api_key_here"
PINATA_API_SECRET="your_pinata_api_secret_here"
PINATA_JWT="your_pinata_jwt_here"
