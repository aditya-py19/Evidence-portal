generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  police_officer
  investigating_officer
  forensic_expert
  judge
  administrator
}

model User {
  id                 String        @id @default(cuid())
  username           String        @unique
  email              String        @unique
  name               String
  role               UserRole
  department         String
  badgeNumber        String
  passwordHash       String
  isActive           Boolean       @default(true)
  mustChangePassword Boolean       @default(false)
  lastLoginAt        DateTime?
  createdById        String?
  createdBy          User?         @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers       User[]        @relation("UserCreatedBy")
  activityLogs       ActivityLog[]
  evidences          Evidence[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  activity  String
  username  String
  role      UserRole
  target    String   @default("System")
  severity  String   @default("info")
  ipAddress String   @default("127.0.0.1")
  details   String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model Evidence {
  id                String   @id @default(cuid())
  evidenceId        String   @unique
  caseId            String   @default("TC-2026-0142")
  caseTitle         String   @default("Cyber Fraud – UPI Payment Scam")
  type              String   @default("image")
  fileName          String
  fileSize          String
  ipfsCid           String
  ipfsGatewayUrl    String
  sha256            String
  trustScore        Int      @default(78)
  trustLevel        String   @default("needs_review")
  status            String   @default("ai_review")
  blockchainTxId    String?
  transactionHash   String?
  blockNumber       Int?
  contractAddress   String?
  network           String?  @default("Polygon Amoy Testnet")
  gasUsed           String?
  digitalSignature  String?
  currentOwner      String   @default("Rajesh Kumar")

  currentDepartment String   @default("Cyber Crime Cell, Delhi Police")
  lastAccess        DateTime @default(now())
  aiAnalysis        Json?
  trustBreakdown    Json?
  geoStatus         String   @default("verified")
  geoDistance       Float    @default(0.5)
  allowedRadius     Float    @default(5.0)
  crimeLocation     Json?
  uploadLocation    Json?
  uploaderId        String?
  uploader          User?    @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  uploadedBy        String   @default("Unknown Officer")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}


model Notification {
  id        String   @id @default(cuid())
  type      String   @default("upload")
  title     String
  message   String
  timestamp DateTime @default(now())
  read      Boolean  @default(false)
  priority  String   @default("medium")
  link      String?
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


