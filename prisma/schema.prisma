generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  police_officer
  investigating_officer
  forensic_expert
  judge
  administrator
}

model User {
  id                 String        @id @default(cuid())
  username           String        @unique
  email              String        @unique
  name               String
  role               UserRole
  department         String
  badgeNumber        String
  passwordHash       String
  isActive           Boolean       @default(true)
  mustChangePassword Boolean       @default(false)
  lastLoginAt        DateTime?
  createdById        String?
  createdBy          User?         @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers          User[]                  @relation("UserCreatedBy")
  activityLogs          ActivityLog[]
  evidences             Evidence[]
  officerRequests       AccessRequest[]         @relation("OfficerAccessRequests")
  reviewedRequests      AccessRequest[]         @relation("AdminReviewedRequests")
  judicialNotes         JudicialNote[]          @relation("JudgeJudicialNotes")
  judgeClarifications   EvidenceClarification[] @relation("JudgeClarifications")
  officerClarificationResponses EvidenceClarification[] @relation("OfficerClarificationResponses")
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  activity  String
  username  String
  role      UserRole
  target    String   @default("System")
  severity  String   @default("info")
  ipAddress String   @default("127.0.0.1")
  details   String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model Evidence {
  id                String   @id @default(cuid())
  evidenceId        String   @unique
  caseId            String?
  caseTitle         String?
  assignmentStatus  String   @default("ASSIGNED") // ASSIGNED, UNASSIGNED
  type              String   @default("image")
  fileName          String
  fileSize          String
  ipfsCid           String
  ipfsGatewayUrl    String
  sha256            String
  trustScore        Int      @default(78)
  trustLevel        String   @default("needs_review")
  status            String   @default("ai_review")
  blockchainTxId    String?
  transactionHash   String?
  blockNumber       Int?
  contractAddress   String?
  network           String?  @default("Polygon Amoy Testnet")
  gasUsed           String?
  digitalSignature  String?
  currentOwner      String   @default("Rajesh Kumar")

  currentDepartment String   @default("Cyber Crime Cell, Delhi Police")
  lastAccess        DateTime @default(now())
  aiAnalysis        Json?
  trustBreakdown    Json?
  geoStatus         String   @default("verified")
  geoDistance       Float    @default(0.5)
  allowedRadius     Float    @default(5.0)
  crimeLocation     Json?
  uploadLocation    Json?
  uploaderId        String?
  uploader          User?    @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  uploadedBy        String                  @default("Unknown Officer")
  verificationToken String?                 @unique @default(cuid())
  note              String?
  clarifications    EvidenceClarification[]
  captureSource     String                  @default("WEB") // WEB, SECURE_EVIDENCE_CAMERA
  captureMode       String?                 // PHOTO, VIDEO
  capturedAt        DateTime?
  captureStartedAt  DateTime?
  captureEndedAt    DateTime?
  captureDuration   Int?
  clientSha256      String?
  serverSha256      String?
  locationStatus    String?                 // RECORDED, UNAVAILABLE, PERMISSION_DENIED
  locationPoints    EvidenceLocationPoint[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
}

model Case {
  id                  String                  @id @default(cuid())
  caseId              String                  @unique
  title               String
  firNumber           String                  @default("FIR-2026-9042")
  crimeType           String                  @default("Cyber Crime")
  description         String
  location            String                  @default("Connaught Place, New Delhi")
  dateTime            String                  @default("2026-07-28 14:30")
  officerAssigned     String                  @default("Rajesh Kumar")
  officerId           String?
  department          String                  @default("Cyber Crime Cell, Delhi Police")
  priority            String                  @default("high")
  status              String                  @default("active")
  judicialStatus      String                  @default("PENDING_REVIEW") // PENDING_REVIEW, UNDER_REVIEW, REVIEWED
  reviewStartedAt     DateTime?
  reviewCompletedAt   DateTime?
  reviewedById        String?
  verificationToken   String                  @unique @default(cuid())
  judicialNotes       JudicialNote[]
  clarifications      EvidenceClarification[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
}


model Notification {
  id        String   @id @default(cuid())
  type      String   @default("upload")
  title     String
  message   String
  timestamp DateTime @default(now())
  read      Boolean  @default(false)
  priority  String   @default("medium")
  link      String?
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AccessRequest {
  id             String    @id @default(cuid())
  officerId      String
  officer        User      @relation("OfficerAccessRequests", fields: [officerId], references: [id], onDelete: Cascade)
  requestType    String    // CASE_ACCESS, EVIDENCE_ACCESS, DOWNLOAD_PERMISSION, REPORT_ACCESS, ACCOUNT_ACTIVATION, ROLE_PERMISSION
  resourceType   String    // case, evidence, report, account, role
  resourceId     String
  resourceName   String?
  reason         String
  status         String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedById   String?
  reviewedBy     User?     @relation("AdminReviewedRequests", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  decisionReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model JudicialNote {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  judgeId   String
  judge     User     @relation("JudgeJudicialNotes", fields: [judgeId], references: [id], onDelete: Cascade)
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EvidenceClarification {
  id            String    @id @default(cuid())
  caseId        String
  case          Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  evidenceId    String
  evidence      Evidence  @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  requestReason String
  status        String    @default("PENDING") // PENDING, RESPONDED
  judgeId       String
  judge         User      @relation("JudgeClarifications", fields: [judgeId], references: [id], onDelete: Cascade)
  officerId     String?
  officer       User?     @relation("OfficerClarificationResponses", fields: [officerId], references: [id], onDelete: SetNull)
  response      String?
  respondedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model EvidenceLocationPoint {
  id         String   @id @default(cuid())
  evidenceId String
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  timestamp  DateTime
  latitude   Float
  longitude  Float
  accuracy   Float?
  createdAt  DateTime @default(now())
}





